# RepoPilot Environment Configuration
# All settings are optional; RepoPilot operates 100% with default ₹0 zero-budget settings.

# Optional: Personal GitHub Access Token to raise rate limits from 60 req/hr to 5,000 req/hr
# GITHUB_TOKEN=ghp_your_token_here

# Optional: Custom Ollama endpoint (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Default Ollama coding model
# DEFAULT_MODEL=qwen2.5-coder:1.5b

# Optional: Upstash Redis Rate Limiting (Serverless-shared rate limits across Vercel lambdas)
# If omitted, RepoPilot falls back to in-memory best-effort sliding-window rate limiting.
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
